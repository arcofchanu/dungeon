---
import BaseLayout from '../layouts/BaseLayout.astro';
import FilterRail from '../components/FilterRail.astro';
import NoteRow from '../components/NoteRow.astro';
import { allNotes, tagGroups } from '../lib/notes';

const notes = await allNotes();
const groups = await tagGroups();

const description =
  'A personal research archive for AI and LLM red-teaming work — prompt injection, jailbreak taxonomies, model behaviour, and competition write-ups.';
---

<BaseLayout title="Yozakura" description={description} path="/">
  <div class="wrap index">
    <FilterRail groups={groups} total={notes.length} />

    <div class="index-main">
      <div class="index-bar">
        <h1 class="visually-hidden">Notes</h1>
        <button type="button" class="filter-trigger mono" data-filter-open>Filters</button>
        <p class="index-count mono" data-visible-count aria-live="polite">
          {notes.length} notes
        </p>
      </div>

      <div class="index-list" data-note-list>
        {notes.map((note) => <NoteRow note={note} />)}
      </div>

      <p class="index-empty mono" data-empty hidden>No notes match those filters.</p>
    </div>
  </div>
</BaseLayout>

<style>
  .index {
    padding-block: var(--space-4) var(--space-5);
  }

  .index-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-2);
  }

  .filter-trigger {
    background: none;
    border: var(--hairline) solid var(--branch);
    border-radius: 2px;
    color: var(--dusk);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.7rem;
    cursor: pointer;
  }

  .filter-trigger:hover {
    color: var(--blossom);
    border-color: var(--stem);
  }

  .index-count {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--dusk);
  }

  .index-list {
    border-top: var(--hairline) solid var(--branch);
  }

  .index-empty {
    padding: var(--space-5) 0;
    color: var(--dusk);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  @media (min-width: 60rem) {
    .index {
      display: grid;
      grid-template-columns: var(--rail-width) minmax(0, 1fr);
      gap: var(--space-5);
      align-items: start;
      padding-block: var(--space-5) var(--space-6);
    }

    /* The rail is the filter UI on desktop; the trigger is mobile-only. */
    .filter-trigger {
      display: none;
    }

    .index-bar {
      justify-content: flex-end;
    }
  }
</style>
