{
  "name": "yozakura",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run index && node scripts/gen-sw.mjs && npm run verify",
    "index": "pagefind --site dist && node scripts/sync-pagefind.mjs",
    "verify": "node scripts/verify-build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "astro": "astro",
    "clean": "node -e \"const{rmSync}=require('fs');for(const d of ['.astro','dist','node_modules/.astro','node_modules/.vite'])rmSync(d,{recursive:true,force:true});console.log('clean: caches cleared')\"",
    "test": "node scripts/test-plugins.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource-variable/newsreader": "^5.2.5",
    "astro": "^7.1.5",
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "pagefind": "^1.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.34.1"
  }
}
